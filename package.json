{
  "name": "@scarp-lang/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official Scarp Programming Language project website",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "typecheck": "astro check && tsc -p tsconfig.tools.json",
    "check:site": "node --experimental-strip-types scripts/check-site.ts",
    "check": "npm run test:support && npm run typecheck && npm run build && npm run check:site",
    "test:support": "node --experimental-strip-types --test scripts/test-support-report.ts",
    "test:examples": "node --experimental-strip-types scripts/test-examples.ts"
  },
  "dependencies": {
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
