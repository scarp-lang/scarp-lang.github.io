{
  "name": "@scarp-lang/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official Scarp Programming Language project website",
  "scripts": {
    "dev": "vite",
    "build": "node --import tsx scripts/build.ts",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "check:site": "node --experimental-strip-types scripts/check-site.ts",
    "test:nav": "node --import tsx --test scripts/test-mobile-navigation.tsx",
    "check": "npm run test:support && npm run test:render && npm run test:nav && npm run test:search && npm run test:ecosystem && npm run test:releases && npm run test:download-guide && npm run test:release-audit && npm run test:deploy-smoke && npm run test:compatibility && npm run test:migration && npm run test:compiler-pins && npm run check:compiler-pins && npm run typecheck && npm run build && npm run check:site",
    "test:render": "node --import tsx --test scripts/test-render.tsx",
    "test:support": "node --experimental-strip-types --test scripts/test-support-report.ts",
    "test:examples": "node --experimental-strip-types scripts/test-examples.ts",
    "test:search": "node --experimental-strip-types --test scripts/test-search.ts",
    "test:ecosystem": "node --experimental-strip-types --test scripts/test-ecosystem.ts",
    "test:releases": "node --experimental-strip-types --test scripts/test-releases.ts",
    "test:compatibility": "node --experimental-strip-types --test scripts/test-compatibility.ts",
    "test:release-audit": "node --experimental-strip-types --test scripts/test-release-audit.ts",
    "audit:release": "node --experimental-strip-types scripts/audit-release.ts",
    "test:download-guide": "node --import tsx --test scripts/test-download-guide.ts",
    "sync:compiler-pins": "node --experimental-strip-types scripts/sync-compiler-pins.ts --write",
    "check:compiler-pins": "node --experimental-strip-types scripts/sync-compiler-pins.ts --check",
    "test:compiler-pins": "node --experimental-strip-types --test scripts/test-compiler-pins.ts",
    "test:migration": "node --experimental-strip-types --test scripts/test-migration.ts",
    "test:deploy-smoke": "node --experimental-strip-types --test scripts/test-deployment-smoke.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
