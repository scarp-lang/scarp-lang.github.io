---
import Brand from '../components/Brand.astro';
import { navigation, project } from '../data/project';
import '../styles/global.css';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = 'Explore Scarp, an experimental programming language. Discover current features, runnable examples, downloads, and the roadmap ahead.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, project.origin).href;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title === 'Home' ? 'Scarp — Build Beyond Boundaries' : `${title} · Scarp Programming Language`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/brand/scarp-logo.png" />
    <meta name="theme-color" content="#f7f9fc" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title === 'Home' ? 'Build Beyond Boundaries' : title} · Scarp`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${project.origin}/brand/scarp-logo.png`} />
    <meta property="og:image:alt" content="Scarp blue geometric S logo and wordmark" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="Scarp News" href="/feed.xml" />
    <script is:inline>
      try { const stored = localStorage.getItem('scarp-theme'); document.documentElement.dataset.theme = stored === 'dark' || stored === 'light' ? stored : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <Brand />
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" hidden data-menu>Menu <span aria-hidden="true">☰</span></button>
        <nav id="main-nav" aria-label="Main navigation">
          {navigation.map(([label, href]) => <a href={href} aria-current={path.startsWith(href) && href.startsWith('/') ? 'page' : undefined}>{label}</a>)}
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" hidden><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z" /></svg></button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><div><Brand large /><p>An experimental language.<br />A future built in the open.</p></div>
        <div><h2>Explore</h2><a href="/learn/">Learn Scarp</a><a href="/downloads/">Downloads</a><a href="/ai/">AI development</a><a href="/faq/">FAQ</a></div>
        <div><h2>Build together</h2><a href={project.repo}>Language source ↗</a><a href="/contribute/">Contribute</a><a href="/community/">Community</a><a href={project.websiteRepo}>Website source ↗</a></div>
        <div><h2>Stay in the loop</h2><a href="/news/">Project news</a><a href="/feed.xml">RSS feed ↗</a><a href="/support/">Get support</a><a href={`mailto:${project.contact}`}>Contact ↗</a><a href={project.docs + 'hi/'} lang="hi">हिंदी में सीखें ↗</a></div>
      </div>
      <div class="footer-bottom"><span>© 2026 Scarp Programming Language</span><span>Website: MIT · Language: Apache-2.0</span><span>Built with curiosity. Shared openly.</span></div>
    </footer>
    <div class="sr-only" role="status" aria-live="polite" data-announcement></div>
    <script>import '../scripts/site';</script>
  </body>
</html>
