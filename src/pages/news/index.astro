---
import Base from '../../layouts/Base.astro';
import { news } from '../../data/project';
---
<Base title="News" description="Release highlights and updates from the Scarp Programming Language project.">
  <section class="wrap page-heading"><p class="eyebrow">Project news</p><h1>The language.<br />The journey.</h1><p class="lead">Release highlights and notes from a project taking shape.</p><a class="inline-link" href="/feed.xml">Subscribe with RSS ↗</a></section>
  <section class="wrap news-grid section compact">{news.map(item => <a class="news-card" href={item.href}><div class="news-meta"><span>{item.category}</span><time datetime={item.date}>1 November 2026</time></div><h2>{item.title}</h2><p>{item.description}</p><span class="text-link">Read the update ↗</span></a>)}</section>
</Base>
