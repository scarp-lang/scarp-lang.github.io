---
import Base from '../layouts/Base.astro';
import CodeExplorer from '../components/CodeExplorer.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { capabilities, news, project, sourceUrl } from '../data/project';
---
<Base title="Home">
  <section class="hero wrap">
    <a class="release-pill" href="/releases/"><span class="status-dot" aria-hidden="true"></span>v{project.version}<span class="pill-label">Experimental prerelease</span><span aria-hidden="true">↗</span></a>
    <div class="hero-grid">
      <div class="hero-copy"><p class="eyebrow">The Scarp Programming Language</p><h1>Build beyond<br /><span>boundaries.</span></h1><p class="hero-description">A language taking shape.<br />A new space for your ideas.</p><p class="hero-detail">Explore clear syntax, typed functions, and numerical foundations in an open, experimental language.</p><div class="actions"><a class="button primary" href="/learn/">Start with Scarp <span aria-hidden="true">→</span></a><a class="button secondary" href={project.repo}>Explore the source <span aria-hidden="true">↗</span></a></div><p class="small muted">Early alpha. Try it, question it, help shape it.</p></div>
      <div class="hero-code"><div class="code-overline"><span>Ideas into expressions</span><span aria-hidden="true">.srp</span></div><CodeExplorer /><p class="code-footnote">Real syntax. Expected output. <a href="/development/#evidence">See the baseline ↗</a></p></div>
    </div>
    <div class="foundation-strip"><span><b>Rust</b> interpreter implementation</span><span><b>Apache-2.0</b> language source</span><span><b>Open development</b> from the beginning</span></div>
  </section>

  <section class="section wrap" aria-labelledby="foundations-title">
    <div class="section-heading"><div><p class="eyebrow">Built from the fundamentals</p><h2 id="foundations-title">Small language.<br />Serious foundations.</h2></div><p>Explore what you can use today.<br />Every capability here is part of the published alpha.</p></div>
    <div class="feature-grid">{capabilities.map(feature => <a class="feature" href={sourceUrl(feature.link)}><span class="feature-number">{feature.number} <span aria-hidden="true">↗</span></span><h3>{feature.title}</h3><p>{feature.text}</p><span class="text-link">{feature.label}</span></a>)}</div>
    <a class="inline-link" href="/features/">Explore the language features <span aria-hidden="true">→</span></a>
  </section>

  <section class="development-section" aria-labelledby="development-title"><div class="wrap development-grid">
    <div><p class="eyebrow">An honest look at the present</p><h2 id="development-title">Early days.<br />Real progress.</h2><p>Scarp is a working interpreter with a growing numerical core. Its syntax and APIs are evolving, and the path to a stable language is still ahead.</p><a class="inline-link" href="/development/">Explore the current state <span aria-hidden="true">→</span></a></div>
    <div class="status-board"><div class="status-board-header"><span class="status-badge">Published alpha</span><span class="mono">v{project.version}</span></div><h3>Source modules</h3><p>The latest published milestone brings relative imports and explicit public exports to multi-file programs.</p><ol class="milestone-list"><li><span class="milestone-marker done" aria-hidden="true">✓</span><div><b>Available now</b><span>Functions, numerical values & source modules</span></div></li><li><span class="milestone-marker" aria-hidden="true">02</span><div><b>Next priorities</b><span>Module tooling, conformance & navigation</span></div></li><li><span class="milestone-marker" aria-hidden="true">03</span><div><b>Further ahead</b><span>Types, compiler backend & domain libraries</span></div></li></ol><a class="inline-link" href="/roadmap/">Follow the roadmap <span aria-hidden="true">→</span></a></div>
  </div></section>

  <section class="section wrap learning-grid" aria-labelledby="learning-title"><div><p class="eyebrow">Your first few lines</p><h2 id="learning-title">Curiosity is<br />all you need.</h2><p class="section-description">Start with a small program. Learn the fundamentals in English or Hindi, then explore functions and numerical examples.</p><div class="actions"><a class="button primary" href={project.docs + 'guide/first-program'}>Read the first-program guide <span aria-hidden="true">↗</span></a><a class="inline-link" href={project.docs + 'hi/'} lang="hi">हिंदी में सीखें ↗</a></div></div><div class="quickstart"><p class="eyebrow">01 / Get the interpreter</p><p><a href="/downloads/">Download a package</a> for your platform.</p><p class="eyebrow">02 / Save hello.srp</p><CodeBlock filename="hello.srp" code={'print("Hello from Scarp!");'} /><p class="eyebrow">03 / Run from its folder</p><CodeBlock filename="terminal" code={'./scarp run hello.srp'} /><p class="small muted">Windows PowerShell: use <code>./scarp.exe</code>.</p></div></section>

  <section class="section news-section wrap" aria-labelledby="news-title"><div class="section-heading"><div><p class="eyebrow">From the project</p><h2 id="news-title">The latest chapter.</h2></div><a class="inline-link" href="/news/">All project news <span aria-hidden="true">→</span></a></div><div class="news-grid">{news.map(item => <a class="news-card" href={item.href}><div class="news-meta"><span>{item.category}</span><time datetime={item.date}>01 Nov 2026</time></div><h3>{item.title}</h3><p>{item.description}</p><span class="text-link">Read the update <span aria-hidden="true">↗</span></span></a>)}</div></section>

  <section class="community-callout wrap"><span class="eyebrow">Made in the open</span><h2>A language grows<br />with its community.</h2><p>Bring a question, a test case, or a different perspective.<br />There’s room to help shape what comes next.</p><div class="actions"><a class="button primary" href="/contribute/">Find your way to contribute <span aria-hidden="true">→</span></a><a class="button secondary" href="/community/">Meet the community <span aria-hidden="true">↗</span></a></div></section>
</Base>
